<configuration>
    <property name="LOG_PORT" value="${lunamux.port:-8082}"/>
    <property name="LOG_DIR" value="${user.home}/.termtastic/logs"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/server-${LOG_PORT}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/server-${LOG_PORT}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!--
        Third-party libraries log at INFO. At the previous root level of TRACE, Ktor emitted a
        full routing-resolution trace plus two ContentNegotiation lines for every single request,
        and Netty a complete stack trace per failed TLS handshake — tens of lines per request,
        which grew the server log to ~90 MB and buried the entries worth reading.
    -->
    <root level="info">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
    <!-- Our own code keeps DEBUG: it is low-volume and it is what we actually diagnose from. -->
    <logger name="se.soderbjorn.lunamux" level="DEBUG"/>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <logger name="com.jediterm" level="ERROR"/>
    <logger name="c.j.terminal.emulator.JediEmulator" level="ERROR"/>
    <logger name="io.ktor.websocket" level="INFO"/>
    <logger name="org.sqlite.core.NativeDB" level="INFO"/>
</configuration>
